# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work

# Configuration files. config-json.yaml holds no credentials and stays tracked
# as a preset; anything pointing at Elasticsearch does not.
config.yaml
config-elasticsearch.yaml
!*.example

# Data and output files
# output/
epss-data/
# JSON data files (but keep config JSONs)
*batch*.json
*checkpoint*.json
*stats*.json
test-*.json
elasticsearch-*.json
epss-fetcher
# Keep go.mod and go.sum (they're not JSON anyway)
# go.mod and go.sum are automatically included

# Logs and stats
*.log
*.txt
checkpoint.json
*-checkpoint.json
*-stats.txt

# Claude Code
CLAUDE.md

# Secrets / local-only
.ssh_upas
epss-fetcher-linux

# IDE files
.vscode/
.idea/
*.swp
*.swo

